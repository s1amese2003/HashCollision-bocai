HOST=127.0.0.1
PORT=8090
DB_PATH=/var/lib/predict/app.db
WEB_DIR=/opt/HashCollision-bocai/web/dist
ADMIN_USERNAMES=admin
# Set to 1 once the site is served over HTTPS.
COOKIE_SECURE=0
SIGNUP_BONUS=1000
CHECKIN_BONUS=100
DISPUTE_WINDOW_HOURS=24
NODE_ENV=production
# Platform liquidity added to every new market, in points.
HOUSE_SUBSIDY=500
MIN_SUBSIDY=50
# Trading fee in basis points (200 = 2%), paid into the market pool.
TRADE_FEE_BPS=200
# Per-user, per-side position cap as a multiple of the market's b (0 = no cap).
POSITION_CAP_B=2
